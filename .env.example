# API
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/foucusly.sqlite
# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
AUTH_SECRET=
CORS_ORIGINS=
# Fastify trustProxy: true/false or comma-separated IP/CIDR list. Empty = true in production, false otherwise.
TRUST_PROXY=
# Max successful sign-ups per client IP within SIGNUP_WINDOW_HOURS (0 disables). IPs are stored only as salted SHA-256.
SIGNUP_LIMIT_PER_IP=1
SIGNUP_WINDOW_HOURS=24
# Optional salt for IP hashes (defaults to AUTH_SECRET).
SIGNUP_IP_SALT=
# Optional Cloudflare Turnstile. When set, POST /api/auth/register requires a valid turnstileToken.
TURNSTILE_SECRET_KEY=

# Web (build time)
# Public Turnstile site key; when set, the Create account form shows the captcha widget.
VITE_TURNSTILE_SITE_KEY=
